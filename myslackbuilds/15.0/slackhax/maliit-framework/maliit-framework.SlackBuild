#!/bin/sh
#
# SlackBuild for maliit-framework, the Maliit input method framework
# (library, maliit-server and the Qt5 input context plugin).
#
CWD=$(pwd)
TMP=${TMP:-/tmp}
OUTPUT=${OUTPUT:-/tmp}
VERSION=${VERSION:-2.3.0}
PKG_VERSION=${VERSION}
BUILD=${BUILD:-1_k}

APP=maliit-framework
WRKDIR=$TMP/wrk-$APP
PKGDIR=$WRKDIR/package
BLDDIR=$WRKDIR/build

case "$(uname -m)" in
  x86_64)  ARCH=x86_64 ; LIBDIRSUFFIX=64 ;;
  i?86)    ARCH=i586   ; LIBDIRSUFFIX="" ;;
  arm*)    ARCH=arm    ; LIBDIRSUFFIX="" ;;
  aarch64) ARCH=aarch64; LIBDIRSUFFIX=64 ;;
  *)       ARCH=$(uname -m); LIBDIRSUFFIX="" ;;
esac

if [ "$ARCH" = "i586" ]; then
  SLKCFLAGS="-O2 -march=i586 -mtune=i686"
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -fPIC"
else
  SLKCFLAGS="-O2"
fi

rm -rf $WRKDIR
mkdir -p $PKGDIR/install
cp $CWD/slack-desc $PKGDIR/install/slack-desc

mkdir -p $BLDDIR
cd $BLDDIR
tar xf $CWD/$APP-$VERSION.tar.gz
cd framework-$VERSION

mkdir -p build
cd build
cmake \
  -DCMAKE_INSTALL_PREFIX=/usr \
  -DCMAKE_INSTALL_LIBDIR=lib$LIBDIRSUFFIX \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_FLAGS="$SLKCFLAGS" \
  -DCMAKE_CXX_FLAGS="$SLKCFLAGS" \
  -DLIB_INSTALL_DIR=/usr/lib$LIBDIRSUFFIX \
  -Denable-docs=OFF \
  -Denable-tests=OFF \
  -Denable-examples=OFF \
  -Denable-wayland=OFF \
  -Denable-glib=ON \
  -Denable-xcb=ON \
  -Denable-hwkeyboard=ON \
  -Denable-qt5-inputcontext=ON \
  ..
make
make install DESTDIR=$PKGDIR

find $PKGDIR | xargs file | grep -E "executable|shared object" | grep ELF |
  cut -f 1 -d : | xargs --no-run-if-empty strip --strip-unneeded 2> /dev/null ||
  true

cd $PKGDIR
chown -R root:root .
chmod -R u+w,go+r-w,a-s .
/sbin/makepkg -l y -c n $OUTPUT/$APP-$PKG_VERSION-$ARCH-$BUILD.tgz
