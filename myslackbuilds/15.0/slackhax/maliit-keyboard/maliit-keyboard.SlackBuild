#!/bin/sh
#
# SlackBuild for maliit-keyboard, the Maliit on-screen keyboard
# (the keyboard Plasma uses for touch input).
#
CWD=$(pwd)
TMP=${TMP:-/tmp}
OUTPUT=${OUTPUT:-/tmp}
VERSION=${VERSION:-2.3.1}
PKG_VERSION=${VERSION}
BUILD=${BUILD:-1_k}

APP=maliit-keyboard
WRKDIR=$TMP/wrk-$APP
PKGDIR=$WRKDIR/package
BLDDIR=$WRKDIR/build

# layouts to keep; everything else is pruned (a long list is unusable on a
# small screen).  ja needs anthy, en needs hunspell for word suggestions.
LANGUAGES="en en@dv ja"

case "$(uname -m)" in
  x86_64)  ARCH=x86_64 ; LIBDIRSUFFIX=64 ;;
  i?86)    ARCH=i586   ; LIBDIRSUFFIX="" ;;
  arm*)    ARCH=arm    ; LIBDIRSUFFIX="" ;;
  aarch64) ARCH=aarch64; LIBDIRSUFFIX=64 ;;
  *)       ARCH=$(uname -m); LIBDIRSUFFIX="" ;;
esac

if [ "$ARCH" = "i586" ]; then
  SLKCFLAGS="-O2 -march=i586 -mtune=i686"
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -fPIC"
else
  SLKCFLAGS="-O2"
fi

rm -rf $WRKDIR
mkdir -p $PKGDIR/install
cp $CWD/slack-desc $PKGDIR/install/slack-desc
cp $CWD/doinst.sh $PKGDIR/install/doinst.sh

mkdir -p $BLDDIR
cd $BLDDIR
tar xf $CWD/$APP-$VERSION.tar.gz
cd keyboard-$VERSION

mkdir -p build
cd build
cmake \
  -DCMAKE_INSTALL_PREFIX=/usr \
  -DCMAKE_INSTALL_LIBDIR=lib$LIBDIRSUFFIX \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_FLAGS="$SLKCFLAGS" \
  -DCMAKE_CXX_FLAGS="$SLKCFLAGS" \
  -DLIB_INSTALL_DIR=/usr/lib$LIBDIRSUFFIX \
  -DHUNSPELL_DICT_PATH=/usr/share/hunspell \
  -Denable-hunspell=ON \
  -Denable-tests=OFF \
  ..
make
make install DESTDIR=$PKGDIR

# prune the language layouts
for dir in $PKGDIR/usr/lib$LIBDIRSUFFIX/maliit/keyboard2/languages/*/; do
  lang=$(basename "$dir")
  case " $LANGUAGES " in
    *" $lang "*) ;;
    *) rm -rf "$dir" ;;
  esac
done

find $PKGDIR | xargs file | grep -E "executable|shared object" | grep ELF |
  cut -f 1 -d : | xargs --no-run-if-empty strip --strip-unneeded 2> /dev/null ||
  true

cd $PKGDIR
chown -R root:root .
chmod -R u+w,go+r-w,a-s .
/sbin/makepkg -l y -c n $OUTPUT/$APP-$PKG_VERSION-$ARCH-$BUILD.tgz
