#!/bin/sh -e
CWD=$(pwd)
TMP=${TMP:-/tmp}
OUTPUT=${OUTPUT:-/tmp}
VERSION=${VERSION:-3.7}
PKG_VERSION=${VERSION}

BUILD=${BUILD:-1_k}

APP=iio-sensor-proxy
WRKDIR=$TMP/wrk-$APP
PKGDIR=$WRKDIR/package
BLDDIR=$WRKDIR/build

if [ -z "$ARCH" ]; then
	case "$( uname -m )" in
		x86_64) ARCH=x86_64 ;;
		*)      ARCH=$( uname -m ) ;;
	esac
fi

if [ "$ARCH" = "x86_64" ]; then
	LIBDIRSUFFIX="64"
else
	LIBDIRSUFFIX=""
fi

if [ -z "$SLKCFLAGS" ]; then
	SLKCFLAGS="-O2 -fPIC"
fi

rm -rf $WRKDIR
mkdir -p $PKGDIR/install
cp $CWD/slack-desc $PKGDIR/install/slack-desc

mkdir -p $BLDDIR
tar xf $CWD/$APP-$VERSION.tar.gz -C $BLDDIR
cd $BLDDIR/$APP-$VERSION

# needs gudev >= 237 and polkit-gobject, both in stock 15.0.
# 3.8 was the first release to require gio >= 2.76 (g_autofd); stock 15.0
# ships glib2 2.70.3, so 3.7 is the newest version that builds here.
# no systemd on slackware
CFLAGS="$SLKCFLAGS" \
meson setup build \
	--prefix=/usr \
	--libdir=lib$LIBDIRSUFFIX \
	--sysconfdir=/etc \
	--localstatedir=/var \
	--mandir=/usr/man \
	--buildtype=release \
	-Dudevrulesdir=/lib/udev/rules.d \
	-Dsystemdsystemunitdir=/usr/lib/systemd/system
ninja -C build
DESTDIR=$PKGDIR ninja -C build install

# sysvinit: no systemd unit, the daemon gets activated over the system bus
# (same thing systemd's dbus generator does with the unit)
rm -rf $PKGDIR/usr/lib/systemd
mkdir -p $PKGDIR/usr/share/dbus-1/system-services
cat <<-EOF > $PKGDIR/usr/share/dbus-1/system-services/net.hadess.SensorProxy.service
[D-BUS Service]
Name=net.hadess.SensorProxy
Exec=/usr/libexec/iio-sensor-proxy
User=root
EOF

# make udev aware of the new rules, for devices that are already present
cat <<-EOF > $PKGDIR/install/doinst.sh
if [ -x /sbin/udevadm ]; then
	/sbin/udevadm control --reload-rules
	/sbin/udevadm trigger --action=change --subsystem-match=iio --subsystem-match=hwmon --subsystem-match=input
fi
EOF
chmod 755 $PKGDIR/install/doinst.sh

find $PKGDIR -print0 | xargs -0 file | grep -e "executable" -e "shared object" | grep ELF \
	| cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

cd $PKGDIR
chown -R root:root .
chmod -R u+w,go+r-w,a-s .
/sbin/makepkg -l y -c n $OUTPUT/$APP-$PKG_VERSION-$ARCH-$BUILD.tgz
